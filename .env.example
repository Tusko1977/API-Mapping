# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and never leaves your machine.

# Only needed for local dev, where `next dev` (localhost:3000) and the
# ASP.NET Core API (`dotnet run`, api/) run as separate processes on
# separate ports. Leave unset in production - the built static site is
# served by the API itself, from the same origin, so relative "/api/..."
# requests just work. See src/components/EntityGrid.tsx.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5068
