{
  "info": {
    "name": "API Mapping Catalogue API",
    "description": "CRUD endpoints for the API Mapping Catalogue. Set baseUrl to http://localhost:3000 for local testing or your Vercel URL. 'Create entity' stores the new id in the entityId variable for the other requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "entityId", "value": "" }
  ],
  "item": [
    {
      "name": "List entities",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/entities?search=",
          "host": ["{{baseUrl}}"],
          "path": ["api", "entities"],
          "query": [{ "key": "search", "value": "", "description": "Optional. Matches any text field, case-insensitive." }]
        }
      }
    },
    {
      "name": "Create entity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "if (body.id) pm.collectionVariables.set('entityId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"AccountHeader\",\n  \"description\": \"Description for AccountHeader\",\n  \"tablesAffected\": \"xx_chr20,xx_cna50,xx_nhr20\",\n  \"verb\": \"GET\",\n  \"resource\": \"accounts\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/entities",
          "host": ["{{baseUrl}}"],
          "path": ["api", "entities"]
        }
      }
    },
    {
      "name": "Get entity",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/entities/{{entityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "entities", "{{entityId}}"]
        }
      }
    },
    {
      "name": "Update entity",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"AccountHeader\",\n  \"description\": \"Updated description\",\n  \"tablesAffected\": \"xx_chr20\",\n  \"verb\": \"PUT\",\n  \"resource\": \"accounts\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/entities/{{entityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "entities", "{{entityId}}"]
        }
      }
    },
    {
      "name": "Delete entity",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/entities/{{entityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "entities", "{{entityId}}"]
        }
      }
    }
  ]
}
